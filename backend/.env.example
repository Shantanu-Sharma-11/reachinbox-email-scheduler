# Database
DATABASE_URL="mysql://root:root@localhost:3306/reachinbox"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth 2.0
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Slack OAuth v2
# Get credentials from: https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback

# Session (generate a strong random string for production)
SESSION_SECRET=

# Rate Limiting (emails per sender per hour)
RATE_LIMIT_PER_HOUR=10

# App
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
